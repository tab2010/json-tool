# ---------- 依赖 ----------
# node_modules 体积巨大且能通过 npm install 重新生成，绝不提交
node_modules/

# ---------- 构建产物 ----------
# dist 是 npm run build 生成的，同样可重新生成，不提交
dist/
dist-ssr/

# ---------- 日志 ----------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 本地/临时文件 ----------
*.local
.cache/
.DS_Store

# ---------- 环境变量 ----------
# 隐私优先项目尤其要注意：任何密钥都别提交
.env
.env.*
!.env.example

# ---------- 编辑器目录 ----------
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.sw?
